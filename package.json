{
  "name": "preguntados-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test && poetry run pytest",
    "quality": "npm --prefix frontend run quality",
    "typecheck": "npm --prefix frontend run typecheck",
    "start:api": "poetry run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "start:db": "docker compose up -d db",
    "load:data": "poetry run python -m app.load_data"
  }
}
